# Cloudflare Workers (static assets) — header ของหน้า Dashboard
# CSP: รูปจาก Discord CDN / OpenWeatherMap / รูปประกอบข่าวที่แอดมินใส่ลิงก์มาเอง (https:) + Cloudflare Web Analytics
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https: https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

/assets/*
  Cache-Control: public, max-age=31536000, immutable
