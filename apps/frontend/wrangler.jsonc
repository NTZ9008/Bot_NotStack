{
  "name": "bot-notstack",
  "compatibility_date": "2026-08-01",
  "previews": {},
  // build หน้าเว็บก่อน deploy ทุกครั้ง (dist/ ไม่อยู่ใน git) — ใช้เมื่อ Root directory ของ Cloudflare = apps/frontend
  "build": {
    "command": "pnpm build",
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
