{
  "name": "@notstack/backend",
  "version": "4.0.0",
  "private": true,
  "description": "NestJS API + Discord bot (discord.js) for NotStackOverflow",
  "scripts": {
    "postinstall": "pnpm run db:generate",
    "prebuild": "pnpm run db:generate",
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm run db:generate",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "node scripts/generate-prisma.mjs",
    "db:migrate": "prisma migrate deploy",
    "discord:deploy-commands": "node dist/scripts/deploy-commands.js"
  },
  "dependencies": {
    "@expo-google-fonts/kanit": "^0.4.1",
    "@expo-google-fonts/noto-color-emoji": "^0.4.6",
    "@expo-google-fonts/noto-sans-thai": "^0.4.2",
    "@expo-google-fonts/prompt": "^0.4.1",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.9",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@notstack/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cron": "4.4.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "gifenc": "^1.0.3",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.7",
    "@nestjs/schematics": "^12.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "typescript": "~6.0.2"
  }
}
