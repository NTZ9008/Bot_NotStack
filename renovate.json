{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "timezone": "Asia/Bangkok",
  "schedule": ["before 9am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "postUpdateOptions": ["pnpmDedupe"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 9am on the first day of the month"]
  },
  "packageRules": [
    {
      "description": "major ต้องกดอนุมัติใน Dependency Dashboard ก่อนถึงจะเปิด PR",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "nestjs",
      "matchPackageNames": ["@nestjs/**"]
    },
    {
      "groupName": "prisma",
      "matchPackageNames": ["prisma", "@prisma/**"]
    },
    {
      "groupName": "tanstack",
      "matchPackageNames": ["@tanstack/**"]
    },
    {
      "groupName": "react",
      "matchPackageNames": ["react", "react-dom", "@types/react", "@types/react-dom"]
    },
    {
      "groupName": "vite",
      "matchPackageNames": ["vite", "@vitejs/**"]
    },
    {
      "groupName": "tailwind",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tw-animate-css"]
    },
    {
      "groupName": "lint and format",
      "matchPackageNames": ["eslint", "@eslint/**", "eslint-plugin-*", "typescript-eslint", "prettier", "globals"]
    },
    {
      "groupName": "fonts",
      "matchPackageNames": ["@expo-google-fonts/**", "@fontsource-variable/**"]
    },
    {
      "groupName": "type definitions",
      "matchPackageNames": ["@types/**"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "github actions",
      "matchManagers": ["github-actions"]
    }
  ]
}
