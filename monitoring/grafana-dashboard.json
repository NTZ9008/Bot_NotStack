        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(notstack_http_request_duration_seconds_bucket{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
