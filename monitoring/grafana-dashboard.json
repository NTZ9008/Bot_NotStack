    {
      "id": 16,
      "type": "table",
      "title": "Top routes",
      "description": "Busiest route templates over the selected range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by(method, route) (increase(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le, method, route) (increase(notstack_http_request_duration_seconds_bucket{job=\"notstack\",instance=~\"$instance\"}[$__range])))",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by(method, route) (increase(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\",status_code=~\"5..\"}[$__range])) / sum by(method, route) (increase(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__range]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "fieldName": "Value #A",
                "config": {
                  "id": "isNull"
                }
              }
            ],
            "type": "exclude",
            "match": "any"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "Requests",
              "Value #B": "p95",
              "Value #C": "5xx %"
            },
            "indexByName": {
              "method": 0,
              "route": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Requests",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "lcd"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "continuous-BlPu"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
