    {
      "id": 9,
      "type": "stat",
      "title": "5xx error rate",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\",status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "5xx",
          "instant": false
