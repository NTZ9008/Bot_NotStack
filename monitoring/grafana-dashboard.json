{
    "__inputs": [
        {
            "name": "DS_PROMETHEUS",
            "label": "Prometheus",
            "type": "datasource",
            "pluginId": "prometheus",
            "pluginName": "Prometheus"
        }
    ],
    "uid": "notstack-overview",
    "title": "NotStack \u2014 System Monitor",
    "tags": ["notstack"],
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "timezone": "browser",
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "templating": {
        "list": [
            {
                "name": "instance",
                "label": "Instance",
                "type": "query",
                "datasource": {
                    "type": "prometheus",
                    "uid": "${DS_PROMETHEUS}"
                },
                "query": "label_values(up{job=\"notstack\"}, instance)",
                "refresh": 1,
                "includeAll": true,
                "allValue": ".*",
                "multi": true,
                "current": {
                    "text": "All",
                    "value": "$__all"
                }
            }
        ]
    },
    "panels": [
        {
            "id": 1,
            "title": "Scrape health (1 = reachable)",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "up{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 2,
            "title": "Database health (1 = healthy)",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_database_up{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 3,
            "title": "Discord ready (1 = connected)",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_discord_ready{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 4,
            "title": "Discord guilds (cached)",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_discord_guilds{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 5,
            "title": "Process uptime",
            "type": "stat",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 16
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "time() - notstack_process_start_time_seconds{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 6,
            "title": "Process CPU (100% = one core)",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 16
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(notstack_process_cpu_seconds_total{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval])",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 7,
            "title": "Process resident memory",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 24
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_process_resident_memory_bytes{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 8,
            "title": "Node.js heap used",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 24
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_nodejs_heap_size_used_bytes{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "bytes"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 9,
            "title": "HTTP requests / second",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 32
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by(instance) (rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval]))",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 10,
            "title": "HTTP 5xx fraction",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 32
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "(sum by(instance) (rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\",status_code=~\"5..\"}[$__rate_interval])) or (0 * sum by(instance) (rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval])))) / sum by(instance) (rate(notstack_http_requests_total{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval]))",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 11,
            "title": "HTTP latency p95",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 40
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by(le,instance) (rate(notstack_http_request_duration_seconds_bucket{job=\"notstack\",instance=~\"$instance\"}[$__rate_interval])))",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 12,
            "title": "Event loop lag p99",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 40
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_nodejs_eventloop_lag_p99_seconds{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 13,
            "title": "Discord gateway heartbeat latency",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 48
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_discord_gateway_ping_seconds{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        },
        {
            "id": 14,
            "title": "Database probe duration",
            "type": "timeseries",
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 48
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "notstack_database_probe_duration_seconds{job=\"notstack\",instance=~\"$instance\"}",
                    "legendFormat": "{{instance}}"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "legend": {
                    "displayMode": "list",
                    "placement": "bottom"
                }
            }
        }
    ]
}
