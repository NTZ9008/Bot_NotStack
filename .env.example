TOKEN=
OPENWEATHER_KEY=
GEMINI_KEY=

# Dashboard Admin Panel
NODE_ENV=dev
DASHBOARD_URL=
# ผู้ดูแลระบบคนแรก — ใช้สร้างบัญชี ADMIN ครั้งแรกเท่านั้น (ADMIN_PASSWORD เป็น bcrypt hash)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# secret สำหรับเซ็น JWT (ยาว 32 ตัวขึ้นไป): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Discord OAuth2 (Developer Portal → OAuth2) — เว้นว่าง = ไม่แสดงปุ่ม "เข้าสู่ระบบด้วย Discord"
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-dashboard.example.com/api/auth/discord/callback
# Discord ID ที่ได้ role ADMIN อัตโนมัติตอนสมัครครั้งแรก (คั่นด้วย ,)
ADMIN_DISCORD_IDS=
# เก็บ audit log ย้อนหลังกี่วัน (ค่าเริ่มต้น 180)
AUDIT_LOG_RETENTION_DAYS=

GITHUB_WEBHOOK_SECRET=

DATABASE_URL=postgresql://USER:PASSWORD@IP:5432/DBNAME
