# ==========================================
# ไฟล์นี้อยู่ที่ root ของ repo (apps/backend อ่านไฟล์นี้ — จะวาง apps/backend/.env ทับบางค่าก็ได้ ไฟล์นั้นชนะ)
# หน้า Dashboard (apps/frontend) ไม่อ่านไฟล์นี้ — ตั้ง VITE_API_URL ตอน build ถ้า API อยู่คนละ subdomain
# ==========================================

# Discord bot — ไม่ใส่ TOKEN = เปิดแค่ API (บอทไม่ login)
TOKEN=
# Application ID ของบอท (ไม่ใส่ = ค่าเดิมจาก config.json รุ่นก่อน)
DISCORD_CLIENT_ID=
# เซิร์ฟเวอร์หลัก — ได้คำสั่งเฉพาะของ NotStack (/verify /addroles /setuproles /admininfo) และค่าเริ่มต้นแบบเดิม
# (ไม่ใส่ = 1273939427575595181) เซิร์ฟเวอร์อื่นเชิญบอทเข้าไปเองได้จากหน้า "เซิร์ฟเวอร์ทั้งหมด" ใน Dashboard
DISCORD_GUILD_ID=

OPENWEATHER_KEY=
GEMINI_KEY=

DATABASE_URL=postgresql://USER:PASSWORD@IP:5432/DBNAME

# Dashboard Admin Panel
NODE_ENV=dev
# พอร์ตของ API (ค่าเริ่มต้น 3035)
PORT=
# URL หน้า Dashboard — ใช้กัน CSRF และเป็นปลายทางหลัง login ด้วย Discord
DASHBOARD_URL=
# (ไม่บังคับ) origin ของหน้าเว็บที่อยู่คนละ subdomain กับ API (คั่นด้วย ,) — ว่าง = หน้าเว็บส่ง /api มาที่โดเมนเดียวกัน
# เปิดให้ทุก subdomain ได้ด้วย * เช่น https://*.example.com (ไม่รวม example.com เอง — ต้องใส่เพิ่มถ้าต้องการ)
CORS_ORIGINS=
# ผู้ดูแลระบบคนแรก — ใช้สร้างบัญชี ADMIN ครั้งแรกเท่านั้น (ADMIN_PASSWORD เป็น bcrypt hash)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# secret สำหรับเซ็น JWT (ยาว 32 ตัวขึ้นไป): node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Discord OAuth2 (Developer Portal → OAuth2) — เว้นว่าง = ไม่แสดงปุ่ม "เข้าสู่ระบบด้วย Discord"
# คนอื่นที่จะเพิ่มเซิร์ฟเวอร์ของตัวเองต้อง login ด้วย Discord (ระบบตรวจสิทธิ์ Manage Server จากบัญชี Discord)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://your-dashboard.example.com/api/auth/discord/callback
# Discord ID ที่ได้ role ADMIN (จัดการได้ทุกเซิร์ฟเวอร์) อัตโนมัติตอนสมัครครั้งแรก (คั่นด้วย ,)
ADMIN_DISCORD_IDS=
# เก็บ audit log ของ Dashboard ย้อนหลังกี่วัน (ค่าเริ่มต้น 180)
AUDIT_LOG_RETENTION_DAYS=
# เก็บ Activity Log (เหตุการณ์ในเซิร์ฟเวอร์ Discord ที่ใช้ทำกราฟหน้า Overview) ย้อนหลังกี่วัน (ค่าเริ่มต้น 90)
ACTIVITY_LOG_RETENTION_DAYS=

# secret ของ webhook เดิม /webhook/github (เซิร์ฟเวอร์หลัก) — เซิร์ฟเวอร์อื่นใช้ URL + secret จากหน้า PR Bot
GITHUB_WEBHOOK_SECRET=

# (ไม่บังคับ) โฟลเดอร์ไฟล์ log ของบอท (ค่าเริ่มต้น <repo>/logs)
LOG_DIR=
# (ไม่บังคับ) ให้ backend เสิร์ฟหน้าเว็บที่ build แล้วเองด้วย เช่น ../frontend/dist — ปกติหน้าเว็บ deploy แยกไป Cloudflare Workers
FRONTEND_DIST=
