{
  "name": "notstack-bot",
  "version": "3.6.0",
  "private": true,
  "description": "Multi-server Discord bot (NotStackOverflow) — monorepo: NestJS backend + React dashboard",
  "author": "AT Tech",
  "license": "ISC",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "start": "pnpm --filter @notstack/backend start",
    "db:generate": "pnpm --filter @notstack/backend db:generate",
    "db:migrate": "pnpm --filter @notstack/backend db:migrate",
    "db:import-sqlite": "pnpm --filter @notstack/backend db:import-sqlite",
    "discord:deploy-commands": "pnpm --filter @notstack/backend discord:deploy-commands"
  },
  "devDependencies": {
    "turbo": "^2.11.4"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.4"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sqlite3",
      "esbuild"
    ]
  }
}
