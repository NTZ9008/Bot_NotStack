{
  "name": "notstack-bot",
  "version": "4.0.0",
  "private": true,
  "description": "Multi-server Discord bot (NotStackOverflow) — monorepo: NestJS backend + React dashboard",
  "author": "AT Tech",
  "license": "ISC",
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "start": "pnpm --filter @notstack/backend start",
    "db:generate": "pnpm --filter @notstack/backend db:generate",
    "db:migrate": "pnpm --filter @notstack/backend db:migrate",
    "discord:deploy-commands": "pnpm --filter @notstack/backend discord:deploy-commands",
    "lint": "eslint .",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx}\" \"packages/*/src/**/*.ts\" \"tests/**/*.cjs\" \"scripts/**/*.mjs\"",
    "test": "turbo run build --filter=@notstack/backend... && pnpm test:unit",
    "test:unit": "node --test tests/safety.test.cjs tests/session.test.cjs tests/xp-rules.test.cjs tests/log-manager.test.cjs tests/weather-command.test.cjs tests/frontend-lib.test.cjs tests/chat.test.cjs",
    "test:integration": "turbo run build --filter=@notstack/backend... && node scripts/test-xp-postgres.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "mysql2": "3.24.4"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "esbuild"
    ]
  }
}
