// ==========================================
// 🐘 PRISMA SCHEMA (PostgreSQL)
// ย้ายมาจาก database.sqlite + prbot/data/messages.sqlite
// ชื่อ field ฝั่ง JS คงเดิม (userId, channelId ...) ส่วนชื่อคอลัมน์ใน Postgres เป็น snake_case ผ่าน @map
// URL ของฐานข้อมูลตั้งใน prisma.config.js (อ่านจาก DATABASE_URL ใน .env)
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ค่าคอนฟิกที่แก้ได้จากหน้า Dashboard (LOG_CHANNEL_ID, PR_CHANNEL_ID ฯลฯ)
model Config {
  key         String  @id
  value       String?
  description String?
  // ลำดับที่สร้าง (แทน rowid ของ SQLite) ให้หน้า Dashboard แสดงรายการเรียงคงที่ แม้มีการแก้ค่า
  sortOrder   Int     @default(autoincrement()) @map("sort_order")

  @@map("config")
}

// ระบบ Level & XP
model Level {
  userId String @id @map("user_id")
  xp     Int    @default(0)
  level  Int    @default(0)

  @@map("levels")
}

// ตั๋วเข้าห้องแบบมีเวลาหมดอายุ
model RoomAccess {
  id       Int      @id @default(autoincrement())
  userId   String   @map("user_id")
  roomId   String   @map("room_id")
  expireAt DateTime @map("expire_at") @db.Timestamptz(3)
  notified Boolean  @default(false)

  @@index([userId, roomId])
  @@map("room_access")
}

// Voice Guard — Whitelist
model VoiceWhitelistChannel {
  channelId String  @id @map("channel_id")
  enabled   Boolean @default(true)
  // ส่ง DM แจ้งผู้ใช้เมื่อถูกเตะออกจากห้องหรือไม่
  notify    Boolean @default(true)

  @@map("voice_whitelist_channels")
}

model VoiceWhitelistUser {
  channelId String @map("channel_id")
  userId    String @map("user_id")

  @@id([channelId, userId])
  @@map("voice_whitelist_users")
}

// Voice Guard — Blacklist
model VoiceBlacklistChannel {
  channelId String  @id @map("channel_id")
  enabled   Boolean @default(true)
  // ส่ง DM แจ้งผู้ใช้เมื่อถูกเตะออกจากห้องหรือไม่
  notify    Boolean @default(true)

  @@map("voice_blacklist_channels")
}

model VoiceBlacklistUser {
  channelId String @map("channel_id")
  userId    String @map("user_id")

  @@id([channelId, userId])
  @@map("voice_blacklist_users")
}

// Log Manager — การตั้งค่าแต่ละ event (แถว __system__ คือสวิตช์เปิด/ปิดทั้งระบบ)
model LogSetting {
  eventKey  String  @id @map("event_key")
  enabled   Boolean @default(false)
  channelId String  @default("") @map("channel_id")
  color     String  @default("")

  @@map("log_settings")
}

// Log Manager — ตัวกรองส่วนกลาง (ค่าเป็น JSON array หรือ '1'/'0')
model LogOption {
  key   String  @id
  value String?

  @@map("log_options")
}

// PR Bot — จำว่า PR ไหนส่งข้อความไปที่ไหน เพื่อแก้ข้อความเดิมตอน PR ถูกปิด
model PrMessage {
  repoFullName String @map("repo_full_name")
  prNumber     Int    @map("pr_number")
  channelId    String @map("channel_id")
  messageId    String @map("message_id")

  @@id([repoFullName, prNumber])
  @@map("pr_messages")
}

// ==========================================
// 🔐 AUTH — ผู้ใช้ Dashboard / Refresh token / Audit log
// ==========================================

enum UserRole {
  USER
  ADMIN
}

// ผู้ใช้ 1 คนเข้าสู่ระบบได้ 2 ทาง: username+password และ/หรือ Discord OAuth (ผูกทั้งสองอย่างกับบัญชีเดียวกันได้)
model User {
  id              Int       @id @default(autoincrement())
  // null = บัญชีที่สมัครผ่าน Discord อย่างเดียว (login ด้วยรหัสผ่านไม่ได้)
  username        String?   @unique
  passwordHash    String?   @map("password_hash")
  discordId       String?   @unique @map("discord_id")
  discordUsername String?   @map("discord_username")
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  role            UserRole  @default(USER)
  isActive        Boolean   @default(true) @map("is_active")
  // เพิ่มค่าเมื่อต้องการให้ access token ทุกใบของผู้ใช้นี้ใช้ไม่ได้ทันที (เปลี่ยนรหัสผ่าน / ออกจากระบบทุกเครื่อง / ปิดบัญชี)
  tokenVersion    Int       @default(0) @map("token_version")
  failedLogins    Int       @default(0) @map("failed_logins")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

// เก็บเฉพาะ SHA-256 ของ refresh token (ตัวจริงอยู่ใน cookie ของผู้ใช้เท่านั้น)
// ทุกครั้งที่ refresh จะออกใบใหม่ใน family เดิม — ถ้าใบที่ถูกแทนแล้วโผล่มาใช้ซ้ำ ถือว่าโดนขโมย และยกเลิกทั้ง family
model RefreshToken {
  id           String    @id @default(uuid())
  userId       Int       @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedById String?   @map("replaced_by_id")
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ประวัติการกระทำใน Dashboard — actorName เก็บชื่อไว้ ณ ตอนนั้น เพื่อให้ยังอ่านได้แม้ผู้ใช้ถูกลบไปแล้ว
model AuditLog {
  id         Int      @id @default(autoincrement())
  actorId    Int?     @map("actor_id")
  actorName  String?  @map("actor_name")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  success    Boolean  @default(true)
  metadata   Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// ==========================================
// 📈 ACTIVITY — เหตุการณ์ทุกอย่างที่เกิดในเซิร์ฟเวอร์ Discord
// Log Manager ส่ง embed เข้าห้อง Discord "และ" บันทึกลงตารางนี้เสมอ
// ใช้ทำกราฟหน้า Overview + หน้า Activity Log ที่ดูย้อนหลังได้จาก Dashboard
// ==========================================
model ActivityEvent {
  id           Int      @id @default(autoincrement())
  // key เดียวกับ Log Manager (voiceJoin, memberLeave ...) + messageSent / commandUsed ที่บันทึกเฉพาะที่นี่
  eventKey     String   @map("event_key")
  guildId      String?  @map("guild_id")
  // ผู้ที่ถูกกระทำ / เจ้าของเหตุการณ์
  userId       String?  @map("user_id")
  userName     String?  @map("user_name")
  isBot        Boolean  @default(false) @map("is_bot")
  channelId    String?  @map("channel_id")
  channelName  String?  @map("channel_name")
  // ผู้ลงมือ (แอดมินที่เตะ/ย้าย/แบน) — ได้จาก Discord audit log
  executorId   String?  @map("executor_id")
  executorName String?  @map("executor_name")
  summary      String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@index([eventKey, createdAt])
  @@index([userId, createdAt])
  @@index([channelId, createdAt])
  @@map("activity_events")
}

// ==========================================
// 🎉 WELCOME ANNOUNCEMENT — การ์ดต้อนรับสมาชิกใหม่แบบรูปภาพ (พื้นหลัง + avatar + ข้อความ)
// แยกจากระบบ Welcome เดิม (WELCOME_CHANNEL_ID ในตาราง config) — ทั้งสองระบบทำงานคู่กันได้
// ==========================================

// การ์ด 1 ใบ = รูปต้อนรับ 1 แบบ ส่งเข้า 1 ห้อง — เปิดหลายใบพร้อมกันได้ (สมาชิกใหม่ 1 คนจะได้ทุกใบที่เปิดอยู่)
model WelcomeCard {
  id           Int      @id @default(autoincrement())
  name         String
  enabled      Boolean  @default(false)
  channelId    String   @default("") @map("channel_id")
  // ข้อความธรรมดาที่ส่งคู่กับรูป (รองรับตัวแปร {mention} {user} {server} ...) — ว่าง = ส่งแค่รูป
  content      String   @default("")
  // การจัดวางทั้งหมด: ขนาดภาพ พื้นหลัง avatar และชั้นข้อความ — รูปแบบตรวจใน welcome/design.js
  design       Json
  // รูปพื้นหลังจากคลังรูป — ลบรูปออกจากคลังแล้วการ์ดจะกลับไปใช้สีพื้นแทน
  backgroundId Int?     @map("background_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  background WelcomeAsset? @relation(fields: [backgroundId], references: [id], onDelete: SetNull)

  @@index([backgroundId])
  @@map("welcome_cards")
}

// คลังรูปพื้นหลังที่อัปโหลดจาก Dashboard — เก็บไฟล์ไว้ในฐานข้อมูล (โฟลเดอร์โปรเจกต์ถูก rsync --delete ทุกครั้งที่ deploy)
model WelcomeAsset {
  id        Int      @id @default(autoincrement())
  name      String
  mimeType  String   @map("mime_type")
  width     Int
  height    Int
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cards WelcomeCard[]

  @@map("welcome_assets")
}

// ==========================================
// 🌤️ DAILY WEATHER REPORT — รายงานสภาพอากาศประจำวัน (embed + กราฟพยากรณ์)
// มีแถวเดียว (id = 1) สร้างให้เองครั้งแรกจากค่าของระบบเดิม (ห้อง GENERAL_CHANNEL_ID, ศาลายา, 07:00)
// ==========================================
model WeatherSetting {
  id        Int       @id @default(1)
  enabled   Boolean   @default(false)
  channelId String    @default("") @map("channel_id")
  // ข้อความธรรมดาที่ส่งคู่กับ embed (รองรับตัวแปร {location} {date} ...) — ว่าง = ส่งแค่ embed
  content   String    @default("")
  // เวลาส่ง / สถานที่ / รูปแบบ embed / กราฟ — รูปแบบตรวจใน weather/options.js
  options   Json
  // ผลการส่งตามเวลาครั้งล่าสุด (lastError = null คือสำเร็จ)
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastError String?   @map("last_error")
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("weather_settings")
}
